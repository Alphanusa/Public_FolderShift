<UserControl x:Class="FolderShift.Views.ReviewStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderShift">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
        <Style x:Key="Th" TargetType="TextBlock" BasedOn="{StaticResource T.Overline}">
            <Setter Property="Margin" Value="16,10" />
        </Style>
        <Style x:Key="NumberDot" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource SurfaceMuted}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Tinjau sebelum mengganti" Style="{StaticResource T.Title}" />
        <TextBlock Text="Salinan sudah lengkap. Cek hasilnya, lalu ganti folder asli dengan tautan." Style="{StaticResource T.Body}" Margin="0,6,0,24" />

        <UniformGrid Columns="4" Margin="0,0,-16,8">
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="UKURAN" Style="{StaticResource T.Overline}" />
                    <TextBlock Text="{Binding SizeCompare}" Style="{StaticResource T.Subheading}" Margin="0,4,0,8" />
                    <ContentControl Content="{Binding SizeStatus}" ContentTemplate="{StaticResource StatusBadge}" Focusable="False" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="JUMLAH FILE" Style="{StaticResource T.Overline}" />
                    <TextBlock Text="{Binding CountCompare}" Style="{StaticResource T.Subheading}" Margin="0,4,0,8" />
                    <ContentControl Content="{Binding CountStatus}" ContentTemplate="{StaticResource StatusBadge}" Focusable="False" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="OWNER" Style="{StaticResource T.Overline}" />
                    <TextBlock Text="{Binding OwnerCompare}" Style="{StaticResource T.Code}" Margin="0,4,0,8" />
                    <ContentControl Content="{Binding OwnerStatus}" ContentTemplate="{StaticResource StatusBadge}" Focusable="False" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="{Binding ContentLabel}" Style="{StaticResource T.Overline}" />
                    <TextBlock Text="{Binding ContentCompare}" Style="{StaticResource T.Subheading}" Margin="0,4,0,8" />
                    <ContentControl Content="{Binding ContentStatus}" ContentTemplate="{StaticResource StatusBadge}" Focusable="False" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource Note.Danger}" Margin="0,0,0,24" Visibility="{Binding VerifyFailed, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Salinan tidak sama dengan sumber" Style="{StaticResource T.Subheading}" Foreground="{StaticResource DangerInk}" />
                <TextBlock Text="Folder asli tidak akan diganti. Biasanya karena ada file yang berubah atau terkunci saat disalin. Batalkan, tutup aplikasi yang memakainya, lalu ulangi."
                           Style="{StaticResource T.BodySm}" Foreground="{StaticResource DangerInk}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="{Binding ShowAcl, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Permission (ACL)" Style="{StaticResource T.Heading}" />
                <TextBlock Text="Hak akses di folder induk, sumber dibanding tujuan." Style="{StaticResource T.Caption}" Margin="0,4,0,16" />

                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <StackPanel>
                        <Grid Background="{StaticResource SurfaceSunken}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="AKUN" Style="{StaticResource Th}" />
                            <TextBlock Grid.Column="1" Text="DI SUMBER" Style="{StaticResource Th}" />
                            <TextBlock Grid.Column="2" Text="DI TUJUAN" Style="{StaticResource Th}" />
                            <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource Th}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AclRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AclRow}">
                                    <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Account}" Style="{StaticResource T.Code}" Margin="16,12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource T.BodySm}" Margin="16,12" />
                                            <TextBlock Grid.Column="2" Text="{Binding Destination}" Style="{StaticResource T.BodySm}" Margin="16,12" />
                                            <ContentControl Grid.Column="3" Content="{Binding Status}" ContentTemplate="{StaticResource StatusBadge}" Margin="16,10" Focusable="False" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Note.Warn}" Margin="0,16,0,0" Visibility="{Binding HasAclDiff, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Samakan dengan sumber" Command="{Binding FixAcl}" Margin="16,0,0,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Permission di tujuan berbeda dengan sumber" Style="{StaticResource T.Subheading}" Foreground="{StaticResource Warning}" />
                            <TextBlock Style="{StaticResource T.BodySm}" Margin="0,4,0,0"
                                       Text="Biasanya karena folder tujuan mewarisi izin dari folder induknya, sehingga akun lain bisa ikut membuka isinya." />
                            <TextBlock Style="{StaticResource T.Caption}" Foreground="{StaticResource Ink2}" Margin="0,4,0,0"
                                       Text="Samakan dengan sumber mematikan warisan izin di folder tujuan, lalu menerapkan ACL yang sama persis dengan sumber." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Note.Ok}" Margin="0,16,0,0" Visibility="{Binding AclFixed, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Permission di tujuan sekarang sama dengan sumber." Style="{StaticResource T.Subheading}" Foreground="{StaticResource Success}" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Ganti folder asli" Style="{StaticResource T.Heading}" />
                <TextBlock Text="Yang terjadi saat kamu menekan tombol di bawah." Style="{StaticResource T.Caption}" Margin="0,4,0,16" />

                <DockPanel Margin="0,0,0,12">
                    <Border Style="{StaticResource NumberDot}"><TextBlock Text="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Style="{StaticResource T.BodySm}">
                        <Run Text="Ganti nama" /> <Run Text="{Binding PlanSource, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Ink}" />
                        <Run Text="jadi" /> <Run Text="{Binding BackupName, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Ink}" />
                    </TextBlock>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                    <Border Style="{StaticResource NumberDot}"><TextBlock Text="2" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Style="{StaticResource T.BodySm}">
                        <Run Text="Buat tautan di lokasi lama yang mengarah ke" /> <Run Text="{Binding PlanDestination, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Ink}" />
                    </TextBlock>
                </DockPanel>
                <DockPanel Margin="0,0,0,16">
                    <Border Style="{StaticResource NumberDot}"><TextBlock Text="3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Buka 3 file acak lewat tautan untuk memastikan tautannya jalan" Style="{StaticResource T.BodySm}" />
                </DockPanel>

                <Border Style="{StaticResource Well}">
                    <DockPanel>
                        <Path Style="{StaticResource Icon}" Data="{StaticResource G.Refresh}" Stroke="{StaticResource Ink2}" VerticalAlignment="Top" Margin="0,0,12,0" />
                        <TextBlock Text="Kalau salah satu langkah gagal, folder asli dikembalikan otomatis. Cadangan baru dihapus kalau kamu memintanya." Style="{StaticResource T.BodySm}" />
                    </DockPanel>
                </Border>

                <DockPanel Margin="0,20,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Danger}" Content="Batalkan dan hapus salinan" Command="{Binding Abort}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Btn.Primary}" Command="{Binding Swap}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon.Small}" Data="{StaticResource G.Link}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SwapLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding SwapNote}" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.Caption}">
                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SwapNoteIsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
