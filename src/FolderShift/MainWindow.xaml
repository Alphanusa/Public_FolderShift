<Window x:Class="FolderShift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderShift"
        xmlns:views="clr-namespace:FolderShift.Views"
        Title="FolderShift" Width="1200" Height="820" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="FolderShift.ico"
        Background="{StaticResource Ground}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource Sans}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type local:MoveViewModel}"><views:MoveView /></DataTemplate>
        <DataTemplate DataType="{x:Type local:HistoryViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type local:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource Btn.Caption}" Click="Minimize_Click" ToolTip="Kecilkan" AutomationProperties.Name="Kecilkan">
                            <Path Data="M0 5.5h10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
                        </Button>
                        <Button Style="{StaticResource Btn.Caption}" Click="Maximize_Click" ToolTip="Perbesar" AutomationProperties.Name="Perbesar">
                            <Path Data="M0.5 0.5h9v9h-9z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
                        </Button>
                        <Button Style="{StaticResource Btn.CaptionClose}" Click="Close_Click" ToolTip="Tutup" AutomationProperties.Name="Tutup">
                            <Path Data="M0 0l10 10M10 0L0 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
                        </Button>
                    </StackPanel>
                    <Image Source="FolderShift.ico" Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="" />
                    <TextBlock Text="FolderShift" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0" />
                </DockPanel>
            </Border>

            <!-- Sidebar -->
            <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="14,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,24">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Accent}">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource G.FolderMove}" Stroke="{StaticResource OnAccent}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FolderShift" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Alphanusa" FontSize="12" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="{Binding IsMovePage}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource G.FolderMove}" Margin="0,0,10,0" />
                                <TextBlock Text="Pindah folder" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="{Binding IsHistoryPage}" HorizontalContentAlignment="Stretch">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceMuted}" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HistoryCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink2}" />
                                </Border>
                                <Path Style="{StaticResource Icon}" Data="{StaticResource G.History}" Margin="0,0,10,0" />
                                <TextBlock Text="Riwayat" VerticalAlignment="Center" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="{Binding IsSettingsPage}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource G.Settings}" Margin="0,0,10,0" />
                                <TextBlock Text="Pengaturan" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Version}" FontSize="12" Foreground="{StaticResource Muted}" Margin="6,10,0,0" />
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceMuted}" CornerRadius="10" Padding="12,10"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon.Small}" Data="{StaticResource G.Shield}" Stroke="{StaticResource AccentInk}" Margin="0,0,8,0" />
                            <TextBlock FontSize="13" Foreground="{StaticResource Ink2}" VerticalAlignment="Center">
                                <Run Text="Berjalan sebagai" /> <Run Text="Administrator" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Grid />
                </DockPanel>
            </Border>

            <!-- Isi -->
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Note.Warn}" Margin="24,16,24,0"
                        Visibility="{Binding ShowAttention, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                            <Button Style="{StaticResource Btn.Small}" Content="Lihat riwayat" Command="{Binding OpenHistory}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn.Small}" Content="Tutup" Command="{Binding DismissAttention}" />
                        </StackPanel>
                        <Rectangle Width="8" Height="8" RadiusX="1" RadiusY="1" Fill="{StaticResource WarningDot}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AttentionText}" Foreground="{StaticResource Warning}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ContentControl Content="{Binding Current}" Focusable="False" />
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
