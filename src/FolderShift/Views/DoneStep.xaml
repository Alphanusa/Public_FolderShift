<UserControl x:Class="FolderShift.Views.DoneStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,24">
            <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource SuccessSoft}" Margin="0,0,20,0" VerticalAlignment="Top">
                <Path Style="{StaticResource Icon}" Data="{StaticResource G.Check}" Stroke="{StaticResource Success}" StrokeThickness="2" HorizontalAlignment="Center">
                    <Path.LayoutTransform><ScaleTransform ScaleX="1.1667" ScaleY="1.1667" /></Path.LayoutTransform>
                </Path>
            </Border>
            <StackPanel>
                <TextBlock Text="{Binding DoneTitle}" Style="{StaticResource T.Title}" />
                <TextBlock Text="{Binding DoneBody}" Style="{StaticResource T.Body}" Margin="0,6,0,0" MaxWidth="680" HorizontalAlignment="Left" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding LinkStatus}" ContentTemplate="{StaticResource StatusBadge}" Focusable="False" />
                            <TextBlock Text="Tautan" Style="{StaticResource T.Heading}" />
                        </DockPanel>
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" Background="{StaticResource AccentSoft}" Margin="0,0,12,0">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource G.Link}" Stroke="{StaticResource AccentInk}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Record.Source}" Style="{StaticResource T.Code}" />
                                    <TextBlock Text="{Binding LinkKindText}" Style="{StaticResource T.Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="22,8,0,8">
                            <Path Style="{StaticResource Icon.Small}" Data="{StaticResource G.ArrowDown}" Stroke="{StaticResource Muted}" Margin="0,0,8,0" />
                            <TextBlock Text="mengarah ke" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Style="{StaticResource Well}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource G.Drive}" Stroke="{StaticResource Ink2}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Record.Destination}" Style="{StaticResource T.Code}" />
                                    <TextBlock Text="{Binding RecordSize}" Style="{StaticResource T.Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="Tautan sudah dites: 3 file acak terbaca lewat lokasi lama." Style="{StaticResource T.Caption}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,24,0,0" Visibility="{Binding ShowBackup, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Cadangan" Style="{StaticResource T.Heading}" />
                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,4,0,16">
                            <Run Text="{Binding Record.Backup, Mode=OneWay}" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Ink2}" /><Run Text=", " /><Run Text="{Binding RecordSize, Mode=OneWay}" />
                        </TextBlock>

                        <StackPanel Visibility="{Binding IsBackupKept, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Buka aplikasinya dan pastikan semuanya normal dulu. Setelah itu, hapus cadangan supaya ruangnya benar-benar lega."
                                       Style="{StaticResource T.BodySm}" Margin="0,0,0,16" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Btn}" Command="{Binding RestoreBackup}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon.Small}" Data="{StaticResource G.Undo}" Margin="0,0,8,0" />
                                        <TextBlock VerticalAlignment="Center"><Run Text="Kembalikan ke" /> <Run Text="{Binding BackupDrive, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Danger}" Content="Hapus cadangan" Command="{Binding AskDeleteBackup}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Note.Danger}" Visibility="{Binding IsBackupConfirm, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding DeleteConfirmTitle}" Style="{StaticResource T.Subheading}" Foreground="{StaticResource DangerInk}" />
                                <TextBlock Text="{Binding DeleteConfirmBody}" Style="{StaticResource T.BodySm}" Foreground="{StaticResource DangerInk}" Margin="0,4,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn}" Content="Batal" Command="{Binding CancelDeleteBackup}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource Btn.DangerSolid}" Content="Hapus cadangan" Command="{Binding DeleteBackup}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Note.Ok}" Visibility="{Binding IsBackupDeleted, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Cadangan dihapus. Ruangnya sudah lega." Style="{StaticResource T.Subheading}" Foreground="{StaticResource Success}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Note.Ok}" Margin="0,24,0,0" Visibility="{Binding IsRestored, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding RestoredText}" Style="{StaticResource T.BodySm}" Foreground="{StaticResource Success}" />
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Ruang drive" Style="{StaticResource T.Heading}" Margin="0,0,0,16" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SourceFreeText}" FontSize="14" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding BackupDrive}" Style="{StaticResource T.Subheading}" />
                    </DockPanel>
                    <ProgressBar Maximum="100" Value="{Binding SourceUsedPercent, Mode=OneWay}" Margin="0,8" />
                    <TextBlock Text="{Binding SourceSpaceNote}" Style="{StaticResource T.Caption}" />

                    <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DestFreeText}" FontSize="14" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding RecordDestDrive}" Style="{StaticResource T.Subheading}" />
                            </DockPanel>
                            <ProgressBar Maximum="100" Value="{Binding DestUsedPercent, Mode=OneWay}" Margin="0,8" />
                            <TextBlock Text="{Binding DestSpaceNote}" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,24,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn}" Content="Lihat riwayat" Command="{Binding GoHistory}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn}" Command="{Binding OpenDestination}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon.Small}" Data="{StaticResource G.Folder}" Margin="0,0,8,0" />
                        <TextBlock Text="Buka di Explorer" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Primary}" Content="Pindah folder lain" Command="{Binding NewMove}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
