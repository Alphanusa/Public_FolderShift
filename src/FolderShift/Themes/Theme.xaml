<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FolderShift">

    <!-- Token warna dari design system Alphanusa Account (tokens.json). Nama sama dengan token aslinya. -->
    <SolidColorBrush x:Key="Ground" Color="#EAF4F5" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#F4F4F5" />
    <SolidColorBrush x:Key="Line" Color="#E4E4E7" />
    <SolidColorBrush x:Key="LineSubtle" Color="#EEEEF0" />
    <SolidColorBrush x:Key="LineStrong" Color="#D4D4D8" />
    <SolidColorBrush x:Key="LineDashed" Color="#C4C4CB" />
    <SolidColorBrush x:Key="Ink" Color="#18181B" />
    <SolidColorBrush x:Key="Ink2" Color="#3F3F46" />
    <SolidColorBrush x:Key="Muted" Color="#52525B" />
    <SolidColorBrush x:Key="Subtle" Color="#71717A" />
    <SolidColorBrush x:Key="Disabled" Color="#A1A1AA" />
    <SolidColorBrush x:Key="Accent" Color="#206B77" />
    <SolidColorBrush x:Key="AccentHover" Color="#185A65" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#D4E8EB" />
    <SolidColorBrush x:Key="AccentInk" Color="#185A65" />
    <SolidColorBrush x:Key="Success" Color="#1E6B3A" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#E6F4EA" />
    <SolidColorBrush x:Key="SuccessDot" Color="#2E8B4E" />
    <SolidColorBrush x:Key="Warning" Color="#8A4300" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FFF1DE" />
    <SolidColorBrush x:Key="WarningDot" Color="#C26A00" />
    <SolidColorBrush x:Key="Danger" Color="#B42318" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FDECEA" />
    <SolidColorBrush x:Key="DangerLine" Color="#F3B8B1" />
    <SolidColorBrush x:Key="DangerInk" Color="#7A1A12" />

    <FontFamily x:Key="Sans">pack://application:,,,/FolderShift;component/Fonts/#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="Mono">pack://application:,,,/FolderShift;component/Fonts/#IBM Plex Mono</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:InverseBoolToVisibility x:Key="NotBoolToVis" />

    <!-- Tipografi -->
    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Subheading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="23" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.BodySm" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- WPF tidak punya text-transform, jadi teks overline ditulis kapital langsung. -->
    <Style x:Key="T.Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="T.Code" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19.5" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Permukaan -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="Well" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style x:Key="PathBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource SurfaceMuted}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Ikon garis 24x24, stroke mengikuti Foreground induk -->
    <!-- Geometri ikon memakai kotak 24x24 seperti SVG di desain; LayoutTransform mengecilkannya ke 18px. -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Icon.Small" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="StrokeThickness" Value="2.4" />
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.6667" ScaleY="0.6667" />
            </Setter.Value>
        </Setter>
    </Style>
    <Geometry x:Key="G.Folder">M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z</Geometry>
    <Geometry x:Key="G.FolderMove">M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M8.5 13h7 M13 10.5l2.5 2.5-2.5 2.5</Geometry>
    <Geometry x:Key="G.History">M21 12a9 9 0 1 1-18 0a9 9 0 1 1 18 0z M12 7v5l3 2</Geometry>
    <Geometry x:Key="G.Settings">M4 7h10 M18 7h2 M4 17h4 M12 17h8 M18 7a2 2 0 1 1-4 0a2 2 0 1 1 4 0z M12 17a2 2 0 1 1-4 0a2 2 0 1 1 4 0z</Geometry>
    <Geometry x:Key="G.Shield">M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z M9 12l2 2 4-4</Geometry>
    <Geometry x:Key="G.Link">M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1 M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1</Geometry>
    <Geometry x:Key="G.Drive">M5 6h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z M7 14h.01 M11 14h6</Geometry>
    <Geometry x:Key="G.Archive">M4 4h16a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9 M10 13h4</Geometry>
    <Geometry x:Key="G.ArrowDown">M12 5v14 M6 13l6 6 6-6</Geometry>
    <Geometry x:Key="G.ArrowRight">M5 12h14 M13 6l6 6-6 6</Geometry>
    <Geometry x:Key="G.Check">M20 6L9 17l-5-5</Geometry>
    <Geometry x:Key="G.Refresh">M20 11a8 8 0 1 0-2.34 5.66 M20 5v6h-6</Geometry>
    <Geometry x:Key="G.Undo">M9 14l-5-5 5-5 M4 9h11a5 5 0 0 1 0 10h-3</Geometry>
    <Geometry x:Key="G.Copy">M11 9h7a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z M5 15V5a1 1 0 0 1 1-1h9</Geometry>

    <!-- Fokus keyboard: outline 2px accent, offset 2px -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="{StaticResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tombol sekunder adalah dasar semua tombol -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceMuted}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Surface}" />
                <Setter Property="Foreground" Value="{StaticResource Disabled}" />
                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Btn.Small" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Surface}" />
                <Setter Property="Foreground" Value="{StaticResource Disabled}" />
                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerSoft}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Disabled}" />
                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Btn.DangerSolid" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerInk}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerInk}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tombol title bar -->
    <Style x:Key="Btn.Caption" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceMuted}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Danger}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Kartu pilihan: drive, metode, dan opsi pengaturan -->
    <Style x:Key="RadioCard" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,1,12,0" VerticalAlignment="Top">
                                <Ellipse x:Name="ring" Stroke="{StaticResource LineStrong}" StrokeThickness="1.5" Fill="{StaticResource Surface}" />
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Accent}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Disabled}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                            <Setter TargetName="bd" Property="Padding" Value="13" />
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}" />
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceSunken}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line}" />
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Line}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Item navigasi sidebar -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0" MinHeight="40">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceMuted}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceMuted}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Chip filter -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="14,0" MinHeight="40">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceMuted}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Switch: menyala accent, mati garis putus-putus -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Width="56" Height="44">
                        <Grid Width="44" Height="26">
                            <Rectangle x:Name="track" RadiusX="13" RadiusY="13" Fill="{StaticResource Surface}"
                                       Stroke="{StaticResource LineDashed}" StrokeThickness="1" StrokeDashArray="3 2" />
                            <Ellipse x:Name="knob" Width="20" Height="20" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{StaticResource Subtle}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Fill" Value="{StaticResource Accent}" />
                            <Setter TargetName="track" Property="Stroke" Value="{StaticResource Accent}" />
                            <Setter TargetName="track" Property="StrokeDashArray" Value="{x:Null}" />
                            <Setter TargetName="knob" Property="Margin" Value="21,0,0,0" />
                            <Setter TargetName="knob" Property="Fill" Value="{StaticResource OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox biasa -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="box" DockPanel.Dock="Left" Width="18" Height="18" Margin="0,1,12,0" VerticalAlignment="Top"
                                CornerRadius="4" BorderThickness="1.5" BorderBrush="{StaticResource LineStrong}" Background="{StaticResource Surface}">
                            <Path x:Name="mark" Data="M3.5 9l3.5 3.5 7-7" Stroke="{StaticResource OnAccent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="{StaticResource SurfaceMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Badge status: warna + kata + bentuk. Aktif bulat, peringatan persegi, netral bulat kosong. -->
    <DataTemplate x:Key="StatusBadge" DataType="{x:Type local:StatusInfo}">
        <Border x:Name="bd" CornerRadius="12" Padding="10,2" Background="{StaticResource SuccessSoft}" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Rectangle x:Name="dot" Width="7" Height="7" RadiusX="3.5" RadiusY="3.5" Fill="{StaticResource SuccessDot}"
                           StrokeThickness="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="tx" Text="{Binding Label}" Foreground="{StaticResource Success}" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Warn">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource WarningSoft}" />
                <Setter TargetName="dot" Property="Fill" Value="{StaticResource WarningDot}" />
                <Setter TargetName="dot" Property="RadiusX" Value="1" />
                <Setter TargetName="dot" Property="RadiusY" Value="1" />
                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Block">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerSoft}" />
                <Setter TargetName="dot" Property="Fill" Value="{StaticResource Danger}" />
                <Setter TargetName="dot" Property="RadiusX" Value="1" />
                <Setter TargetName="dot" Property="RadiusY" Value="1" />
                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource DangerInk}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Neutral">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceMuted}" />
                <Setter TargetName="dot" Property="Fill" Value="Transparent" />
                <Setter TargetName="dot" Property="Stroke" Value="{StaticResource Muted}" />
                <Setter TargetName="dot" Property="StrokeThickness" Value="1.5" />
                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Ink2}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Baris cek / baris status: penanda + judul + keterangan -->
    <DataTemplate x:Key="CheckRow" DataType="{x:Type local:CheckItem}">
        <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Padding="0,14">
            <DockPanel>
                <Rectangle x:Name="dot" DockPanel.Dock="Left" Width="8" Height="8" RadiusX="4" RadiusY="4" Margin="0,7,12,0"
                           VerticalAlignment="Top" Fill="{StaticResource SuccessDot}" />
                <TextBlock x:Name="state" DockPanel.Dock="Right" Text="{Binding Status.Label}" Margin="12,0,0,0" FontSize="13"
                           FontWeight="SemiBold" Foreground="{StaticResource Success}" />
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Subheading}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Status.State}" Value="Warn">
                <Setter TargetName="dot" Property="Fill" Value="{StaticResource WarningDot}" />
                <Setter TargetName="dot" Property="RadiusX" Value="1" />
                <Setter TargetName="dot" Property="RadiusY" Value="1" />
                <Setter TargetName="state" Property="Foreground" Value="{StaticResource Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status.State}" Value="Block">
                <Setter TargetName="dot" Property="Fill" Value="{StaticResource Danger}" />
                <Setter TargetName="dot" Property="RadiusX" Value="1" />
                <Setter TargetName="dot" Property="RadiusY" Value="1" />
                <Setter TargetName="state" Property="Foreground" Value="{StaticResource Danger}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Kotak pesan: info abu, peringatan, error, berhasil -->
    <Style x:Key="Note" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceMuted}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style x:Key="Note.Warn" TargetType="Border" BasedOn="{StaticResource Note}">
        <Setter Property="Background" Value="{StaticResource WarningSoft}" />
    </Style>
    <Style x:Key="Note.Ok" TargetType="Border" BasedOn="{StaticResource Note}">
        <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
    </Style>
    <Style x:Key="Note.Danger" TargetType="Border" BasedOn="{StaticResource Note}">
        <Setter Property="Background" Value="{StaticResource DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerLine}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
