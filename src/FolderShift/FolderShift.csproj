<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 sudah terpasang di Windows 10/11, jadi aplikasi jalan tanpa runtime tambahan. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FolderShift</AssemblyName>
    <RootNamespace>FolderShift</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Dibuat dari Assets/icon.svg (48 px ke atas) dan Assets/icon-small.svg (16-32 px, garis lebih tebal). -->
    <ApplicationIcon>FolderShift.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>0.0.0</Version>
    <Product>FolderShift</Product>
    <Company>Alphanusa</Company>
    <Copyright>Copyright © Alphanusa</Copyright>
    <Description>Pindahkan folder besar dari C ke drive lain lewat junction atau symbolic link.</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies dari NuGet supaya build tidak bergantung pada targeting pack yang terpasang. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="FolderShift.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FolderShift.Tests" />
  </ItemGroup>

</Project>
